# Example environment variables for covid-vaccine-tracker
# Copy to .env and fill values before deploying

# API key used by FastAPI for simple auth (optional)
API_KEY=change_me_generate_a_strong_key

# Database (for Render you can use a managed Postgres URL or keep SQLite path)
# For SQLite on Render, ensure writable path and persistence (Render filesystem is ephemeral without a disk service)
DATABASE_URL=sqlite:///./data/vax_tracker.db

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=https://covid-vaccine-tracker-2025.streamlit.app,http://localhost:8501

# Optional: set a base path for API to be used by frontend
API_BASE_URL=https://your-render-service.onrender.com/api/v1
